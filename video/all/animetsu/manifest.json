{
  "schemaVersion": 2,
  "id": "animetsu",
  "name": "Animetsu",
  "version": "0.1.1",
  "versionCode": 2,
  "apiVersion": 2,
  "wasm": "extension.wasm",
  "contentType": "video",
  "description": "All-language anime catalog and streams from Animetsu.",
  "author": "Manatan Community",
  "homepage": "https://animetsu.net",
  "repository": "https://github.com/Manatan-Community/extensions-source",
  "license": "Apache-2.0",
  "icon": "assets/icon.png",
  "permissions": {
    "network": {
      "allow": [
        "https://animetsu.net",
        "https://animetsu.live",
        "https://animetsu.bz",
        "https://animetsu.cc",
        "https://s4.anilist.co",
        "https://swiftstream.top"
      ]
    },
    "cookies": true,
    "webview": true,
    "storage": false,
    "assets": false,
    "javascript": false
  },
  "assets": [
    {
      "path": "assets/icon.png",
      "mimeType": "image/png",
      "sha256": "0ae72203aa6a1fd47bd5c31afb1b3a8cd920d1404e0420feff5604b1224075e7"
    }
  ],
  "sources": [
    {
      "id": "animetsu",
      "name": "Animetsu",
      "lang": "all",
      "contentType": "video",
      "baseUrl": "https://animetsu.net",
      "contentRating": "adult",
      "capabilities": {
        "search": true,
        "latest": true,
        "filters": true,
        "preferences": true,
        "hosterResolution": true,
        "urlResolution": true,
        "mediaProcessing": true
      },
      "listings": [
        {
          "id": "popular",
          "name": "Popular"
        },
        {
          "id": "latest",
          "name": "Latest"
        }
      ],
      "urlPatterns": [
        {
          "pattern": "https://animetsu.net/anime/*",
          "kind": "item"
        },
        {
          "pattern": "https://animetsu.net/watch/*",
          "kind": "item-or-episode"
        },
        {
          "pattern": "https://animetsu.live/anime/*",
          "kind": "item"
        },
        {
          "pattern": "https://animetsu.live/watch/*",
          "kind": "item-or-episode"
        },
        {
          "pattern": "https://animetsu.bz/anime/*",
          "kind": "item"
        },
        {
          "pattern": "https://animetsu.bz/watch/*",
          "kind": "item-or-episode"
        },
        {
          "pattern": "https://animetsu.cc/anime/*",
          "kind": "item"
        },
        {
          "pattern": "https://animetsu.cc/watch/*",
          "kind": "item-or-episode"
        }
      ],
      "tags": [
        "animetsu"
      ]
    }
  ]
}
