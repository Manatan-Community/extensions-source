    "network": {
      "allow": [
        "anikototv.to", "anikoto.bz", "anikoto.cz", "anikoto.me", "anikoto.net", "anikototv.se",
        "cdn.anipixcdn.co", "mapper.nekostream.site", "*.nekostream.site", "mewcdn.online", "*.mewcdn.online",
        "*.ibyteimg.com", "*.tiktokcdn.com", "vidplay.site", "*.vidplay.site", "vidplay.org", "*.vidplay.org",
        "megacloud.blog", "*.megacloud.blog", "megacloud.club", "*.megacloud.club", "rabbitstream.net", "*.rabbitstream.net",
        "kwik.cx", "*.kwik.cx", "vidstream.pro", "*.vidstream.pro"
      ]
    },
    "cookies": true
  },
  "assets": [
    { "path": "assets/icon.png", "mimeType": "image/png", "sha256": "ce02daff90382ac3b69053d0b912f3d3484080d02bf32022610558d7e5540bae" }
