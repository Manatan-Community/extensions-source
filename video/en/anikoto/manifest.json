{
  "schemaVersion": 2,
  "id": "anikoto",
  "name": "Anikoto",
  "version": "0.1.0",
  "versionCode": 1,
  "apiVersion": 2,
  "wasm": "extension.wasm",
  "contentType": "video",
  "description": "English anime catalog and streams from Anikoto.",
