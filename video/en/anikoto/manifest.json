  "sources": [
    {
      "id": "anikoto",
      "name": "Anikoto",
      "lang": "en",
      "contentType": "video",
      "baseUrl": "https://anikototv.to",
      "contentRating": "safe",
      "capabilities": {
        "search": true, "latest": true, "filters": true, "preferences": true,
        "hosterResolution": true, "urlResolution": true, "mediaProcessing": true
      },
      "listings": [
        { "id": "popular", "name": "Popular" },
        { "id": "latest", "name": "Latest" }
      ],
      "urlPatterns": [
        { "pattern": "https://anikototv.to/watch/*", "kind": "item-or-episode" }
      ],
      "tags": ["anikoto"]
    }
  ]
