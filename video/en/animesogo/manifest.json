{
  "schemaVersion": 2,
  "id": "animesogo",
  "name": "AnimeSogo",
  "version": "0.1.1",
  "versionCode": 2,
  "apiVersion": 2,
  "wasm": "extension.wasm",
  "contentType": "video",
  "description": "English anime catalog and streams from AnimeSogo.",
  "author": "Manatan Community",
  "homepage": "https://animesogo.to",
  "repository": "https://github.com/Manatan-Community/extensions-source",
  "license": "Apache-2.0",
  "icon": "assets/icon.png",
  "permissions": {
    "network": {
      "allow": [
        "https://animesogo.to",
        "https://cdn.anipixcdn.co",
        "https://mapper.nekostream.site",
        "https://*.nekostream.site",
        "https://mewcdn.online",
        "https://*.mewcdn.online",
        "https://*.ibyteimg.com",
        "https://*.tiktokcdn.com",
        "https://vidplay.site",
        "https://*.vidplay.site",
        "https://vidplay.org",
        "https://*.vidplay.org",
        "https://megacloud.blog",
        "https://*.megacloud.blog",
        "https://megacloud.club",
        "https://*.megacloud.club",
        "https://rabbitstream.net",
        "https://*.rabbitstream.net",
        "https://kwik.cx",
        "https://*.kwik.cx",
        "https://vidstream.pro",
        "https://*.vidstream.pro"
      ]
    },
    "cookies": true
  },
  "assets": [
    {
      "path": "assets/icon.png",
      "mimeType": "image/png",
      "sha256": "391b65ededed2fc6c0a0124512d46c1aec248ee0a79fefc34749ac0dd8fc34e2"
    }
  ],
  "sources": [
    {
      "id": "animesogo",
      "name": "AnimeSogo",
      "lang": "en",
      "contentType": "video",
      "baseUrl": "https://animesogo.to",
      "contentRating": "safe",
      "capabilities": {
        "search": true,
        "latest": true,
        "filters": true,
        "preferences": true,
        "hosterResolution": true,
        "urlResolution": true,
        "mediaProcessing": true
      },
      "listings": [
        {
          "id": "popular",
          "name": "Popular"
        },
        {
          "id": "latest",
          "name": "Latest"
        }
      ],
      "urlPatterns": [
        {
          "pattern": "https://animesogo.to/watch/*",
          "kind": "item-or-episode"
        }
      ],
      "tags": [
        "anikoto"
      ]
    }
  ]
}
