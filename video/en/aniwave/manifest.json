{
  "schemaVersion": 2,
  "id": "aniwave",
  "name": "AniWave (Unoriginal)",
  "version": "0.1.0",
  "versionCode": 2,
  "apiVersion": 2,
  "wasm": "extension.wasm",
  "contentType": "video",
  "description": "English anime catalog and streams from AniWave.",
  "author": "Manatan Community",
  "homepage": "https://animewave.to",
  "repository": "https://github.com/Manatan-Community/extensions-source",
  "license": "Apache-2.0",
  "icon": "assets/icon.png",
  "permissions": {
    "network": {
      "allow": [
        "animewave.to",
        "aniwave.cz",
        "cdn.anipixcdn.co",
        "mapper.nekostream.site",
        "*.nekostream.site",
        "mewcdn.online",
        "*.mewcdn.online",
        "*.ibyteimg.com",
        "*.tiktokcdn.com",
        "vidplay.site",
        "*.vidplay.site",
        "vidplay.org",
        "*.vidplay.org",
        "megacloud.blog",
        "*.megacloud.blog",
        "megacloud.club",
        "*.megacloud.club",
        "rabbitstream.net",
        "*.rabbitstream.net",
        "kwik.cx",
        "*.kwik.cx",
        "vidstream.pro",
        "*.vidstream.pro"
      ]
    },
    "cookies": true,
    "webview": false,
    "storage": false,
    "assets": false,
    "javascript": false
  },
  "assets": [
    {
      "path": "assets/icon.png",
      "mimeType": "image/png",
      "sha256": "8d4bd3d0d0960edd0c1f6e2321c69d9c4ec822a2e8f9e4fbbff8e5fc2badff8f"
    }
  ],
  "sources": [
    {
      "id": "aniwave",
      "name": "AniWave (Unoriginal)",
      "lang": "en",
      "contentType": "video",
      "baseUrl": "https://animewave.to",
      "contentRating": "safe",
      "capabilities": {
        "search": true,
        "latest": true,
        "filters": true,
        "preferences": true,
        "hosterResolution": true,
        "urlResolution": true,
        "mediaProcessing": true
      },
      "listings": [
        { "id": "popular", "name": "Popular" },
        { "id": "latest", "name": "Latest" }
      ],
      "urlPatterns": [
        { "pattern": "https://animewave.to/watch/*", "kind": "item-or-episode" },
        { "pattern": "https://aniwave.cz/watch/*", "kind": "item-or-episode" }
      ],
      "tags": ["anikoto"]
    }
  ]
}
