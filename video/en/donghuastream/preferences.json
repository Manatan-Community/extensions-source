      { "label": "Dailymotion", "value": "dailymotion" },
      { "label": "Streamplay", "value": "streamplay" },
      { "label": "Rumble", "value": "rumble" },
      { "label": "Ok.ru", "value": "ok.ru" }
    ]
  },
  {
    "id": "ignore_preview",
    "type": "toggle",
    "label": "Skip Preview episodes",
    "default": true
  }
