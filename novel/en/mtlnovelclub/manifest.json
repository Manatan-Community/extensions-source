{
  "schemaVersion": 2,
  "id": "mtlnovelclub",
  "name": "MTLNovelClub",
  "version": "0.1.0",
  "versionCode": 2,
  "apiVersion": 2,
  "wasm": "extension.wasm",
  "contentType": "novel",
  "description": "English web novels from MTLNovelClub.",
  "author": "Manatan Community",
  "homepage": "https://mtlnovel.club",
  "repository": "https://github.com/Manatan-Community/extensions-source",
  "license": "MPL-2.0",
  "icon": "assets/icon.png",
  "permissions": {
    "network": {
      "allow": [
        "mtlnovel.club"
      ]
    }
  },
  "assets": [
    {
      "path": "assets/icon.png",
      "mimeType": "image/png",
      "sha256": "b16cfe4b91f60ab52bb6f19825ff78f90b929400d09db8ea4e095891397ba3ac"
    }
  ],
  "sources": [
    {
      "id": "mtlnovelclub",
      "name": "MTLNovelClub",
      "lang": "en",
      "contentType": "novel",
      "baseUrl": "https://mtlnovel.club",
      "contentRating": "safe",
      "capabilities": {
        "operations": [
          "commands.describe",
          "commands.detail.fetch",
          "commands.chapter.fetch",
          "commands.content.fetch"
        ],
        "search": true,
        "latest": true,
        "filters": true,
        "urlResolution": true
      },
      "listings": [
        {
          "id": "popular",
          "name": "Popular"
        },
        {
          "id": "latest",
          "name": "Latest"
        }
      ],
      "urlPatterns": [
        {
          "pattern": "https://mtlnovel.club/novel/*",
          "kind": "item-or-chapter"
        }
      ]
    }
  ]
}
