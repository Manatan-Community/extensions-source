{
  "schemaVersion": 2,
  "id": "clicknovel",
  "name": "ClickNovel",
  "version": "0.1.1",
  "versionCode": 3,
  "apiVersion": 2,
  "wasm": "extension.wasm",
  "contentType": "novel",
  "description": "English web novels from ClickNovel.",
  "author": "Manatan Community",
  "homepage": "https://clicknovel.net",
  "repository": "https://github.com/Manatan-Community/extensions-source",
  "license": "MPL-2.0",
  "icon": "assets/icon.png",
  "permissions": {
    "network": {
      "allow": [
        "https://clicknovel.net"
      ]
    }
  },
  "assets": [
    {
      "path": "assets/icon.png",
      "mimeType": "image/png",
      "sha256": "5265e934ca569f4889aaa77d817dad6e0fd744f6cb1c7d801063c0f7c0138bf8"
    }
  ],
  "sources": [
    {
      "id": "clicknovel",
      "name": "ClickNovel",
      "lang": "en",
      "contentType": "novel",
      "baseUrl": "https://clicknovel.net",
      "contentRating": "safe",
      "capabilities": {
        "operations": [
          "commands.describe",
          "commands.detail.fetch",
          "commands.chapter.fetch",
          "commands.content.fetch"
        ],
        "search": true,
        "latest": true,
        "filters": true,
        "urlResolution": true
      },
      "listings": [
        {
          "id": "popular",
          "name": "Popular"
        },
        {
          "id": "latest",
          "name": "Latest"
        }
      ],
      "urlPatterns": [
        {
          "pattern": "https://clicknovel.net/novel/*",
          "kind": "item-or-chapter"
        }
      ]
    }
  ]
}
