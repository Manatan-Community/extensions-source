{
  "schemaVersion": 2,
  "id": "noveltranslate",
  "name": "NovelTranslate",
  "version": "0.1.0",
  "versionCode": 2,
  "apiVersion": 2,
  "wasm": "extension.wasm",
  "contentType": "novel",
  "description": "English web novels from NovelTranslate.",
  "author": "Manatan Community",
  "homepage": "https://noveltranslate.com",
  "repository": "https://github.com/Manatan-Community/extensions-source",
  "license": "MPL-2.0",
  "icon": "assets/icon.png",
  "permissions": {
    "network": {
      "allow": [
        "noveltranslate.com"
      ]
    }
  },
  "assets": [
    {
      "path": "assets/icon.png",
      "mimeType": "image/png",
      "sha256": "cad169a162630dec4d055afa03f646c7a8250c93c62830c733fe01b2d28d22e7"
    }
  ],
  "sources": [
    {
      "id": "noveltranslate",
      "name": "NovelTranslate",
      "lang": "en",
      "contentType": "novel",
      "baseUrl": "https://noveltranslate.com",
      "contentRating": "safe",
      "capabilities": {
        "operations": [
          "commands.describe",
          "commands.detail.fetch",
          "commands.chapter.fetch",
          "commands.content.fetch"
        ],
        "search": true,
        "latest": true,
        "filters": true,
        "urlResolution": true
      },
      "listings": [
        {
          "id": "popular",
          "name": "Popular"
        },
        {
          "id": "latest",
          "name": "Latest"
        }
      ],
      "urlPatterns": [
        {
          "pattern": "https://noveltranslate.com/novel/*",
          "kind": "item-or-chapter"
        }
      ]
    }
  ]
}
