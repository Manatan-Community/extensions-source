  "sources": [
    {
      "id": "bookriver",
      "name": "Bookriver",
      "lang": "ru",
      "baseUrl": "https://bookriver.ru",
      "contentType": "novel",
      "contentRating": "suggestive",
      "capabilities": {
        "search": true,
        "latest": true,
        "filters": true,
        "home": true,
        "urlResolution": true
      },
      "listings": [
