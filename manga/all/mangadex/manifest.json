  "assets": [],
  "sources": [
    {
      "id": "mangadex",
      "name": "MangaDex",
      "lang": "all",
      "contentType": "manga",
      "baseUrl": "https://mangadex.org",
      "contentRating": "suggestive",
      "capabilities": {
        "search": true,
        "latest": true,
        "filters": true,
        "preferences": true,
        "urlResolution": true,
        "pageProcessing": true
      },
      "listings": [
        {
          "id": "popular",
          "name": "Popular"
        },
        {
          "id": "latest",
          "name": "Latest"
        }
      ],
      "urlPatterns": [
        {
          "pattern": "https://mangadex.org/title/*",
          "kind": "item"
        },
        {
          "pattern": "https://mangadex.org/chapter/*",
          "kind": "item-or-chapter"
        },
        {
          "pattern": "https://canary.mangadex.dev/title/*",
          "kind": "item"
        },
        {
          "pattern": "https://canary.mangadex.dev/chapter/*",
          "kind": "item-or-chapter"
        }
      ],
      "tags": [
        "official-api",
        "safe-only",
        "lazy-pages"
      ]
    }
  ]
