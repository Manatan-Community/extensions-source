{
  "schemaVersion": 2,
  "id": "mangafire",
  "name": "MangaFire",
  "version": "1.0.0",
  "versionCode": 1,
  "apiVersion": 2,
  "wasm": "extension.wasm",
  "contentType": "manga",
  "description": "MangaFire with typed chapter language selection and direct JSON API pages.",
  "author": "Manatan Community",
  "homepage": "https://mangafire.to",
  "repository": "https://github.com/Manatan-Community/extensions-source",
  "license": "Apache-2.0",
  "icon": "assets/icon.png",
  "permissions": {
    "network": {
      "allow": [
        "mangafire.to",
        "static.mfcdn.nl",
        "k99.mfcdn1.xyz",
        "k99.mfcdn2.xyz",
        "l1n.mfcdn3.xyz",
        "m3z.mfcdn2.xyz",
        "m3z.mfcdn3.xyz",
        "nw8.mfcdn1.xyz",
        "nw8.mfcdn3.xyz",
        "o48.mfcdn1.xyz",
        "o48.mfcdn2.xyz"
      ]
    },
    "cookies": false,
    "webview": false,
    "storage": false,
    "assets": false,
    "javascript": false
  },
  "assets": [
    {
      "path": "assets/icon.png",
      "mimeType": "image/png",
      "sha256": "b1543e7b1238f29306ba24e9f48e0046dc6c47fc157c3703650bed73f16acf8e"
    }
  ],
  "sources": [
    {
      "id": "mangafire",
      "name": "MangaFire",
      "lang": "all",
      "contentType": "manga",
      "baseUrl": "https://mangafire.to",
      "contentRating": "adult",
      "capabilities": {
        "search": true,
        "latest": true,
        "filters": true,
        "preferences": true,
        "urlResolution": true
      },
      "listings": [
        { "id": "popular", "name": "Popular" },
        { "id": "latest", "name": "Latest" }
      ],
      "urlPatterns": [
        { "pattern": "https://mangafire.to/title/*", "kind": "item-or-chapter" }
      ],
      "tags": ["json-api"]
    }
  ]
}
