{
  "version": 1,
  "filters": [
    {
      "type": "select",
      "id": "sort",
      "name": "Sort by",
      "default": "latest",
      "options": [
        { "label": "New", "value": "recently_added" },
        { "label": "Updated", "value": "latest" },
        { "label": "Popular (Daily)", "value": "popular_daily" },
        { "label": "Popular (Weekly)", "value": "popular_weekly" },
        { "label": "Popular (Monthly)", "value": "popular_monthly" },
        { "label": "Popular (All Time)", "value": "popular_all_time" },
        { "label": "Rating", "value": "rating" },
        { "label": "Title (A-Z)", "value": "az" },
        { "label": "Title (Z-A)", "value": "za" }
      ]
    },
    {
      "type": "select",
      "id": "status",
      "name": "Status",
      "default": "",
      "options": [
        { "label": "Any", "value": "" },
        { "label": "Ongoing", "value": "Ongoing" },
        { "label": "Completed", "value": "Completed" },
        { "label": "Hiatus", "value": "Hiatus" }
      ]
    },
    {
      "type": "select",
      "id": "type",
      "name": "Types",
      "default": "",
      "options": [
        { "label": "Any", "value": "" },
        { "label": "Manga", "value": "Manga" },
        { "label": "Manhwa", "value": "Manhwa" },
        { "label": "Manhua", "value": "Manhua" },
        { "label": "Webtoon", "value": "Webtoon" }
      ]
    },
    { "type": "text", "id": "include_genres", "name": "Included genres, comma separated" },
    { "type": "text", "id": "exclude_genres", "name": "Excluded genres, comma separated" },
    { "type": "text", "id": "tags", "name": "Tags, comma separated" },
    { "type": "text", "id": "min_chapters", "name": "Minimum Chapter" },
    { "type": "text", "id": "max_chapters", "name": "Maximum Chapter" },
    { "type": "text", "id": "min_rating", "name": "Minimum Rating, e.g. 5.0" },
    { "type": "toggle", "id": "only_completed", "name": "Only completed series", "default": false },
    { "type": "toggle", "id": "only_translated", "name": "At least 50+ chapters translated", "default": false },
    { "type": "toggle", "id": "hide_on_break", "name": "Hide long hiatus over 6 months", "default": false }
  ]
}
