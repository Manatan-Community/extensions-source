    "cookies": false,
    "webview": false,
    "storage": false,
    "assets": false,
    "javascript": false
  },
  "assets": [
    {
      "path": "assets/icon.png",
      "mimeType": "image/png",
      "sha256": "512b9b45cc3bff98a718b7d793d4669a0cc5a7cac3ce47c7030230c2d7736403"
    }
  ],
  "sources": [
    {
      "id": "mangamaniacs",
      "name": "MangaManiacs",
      "lang": "en",
      "contentType": "manga",
