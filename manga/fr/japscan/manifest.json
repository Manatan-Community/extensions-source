  "sources": [
    {
      "id": "japscan",
      "name": "Japscan",
      "lang": "fr",
      "baseUrl": "https://www.japscan.foo",
      "contentType": "manga",
      "contentRating": "safe",
      "capabilities": {
        "search": true,
        "latest": true,
        "filters": false,
        "preferences": true,
        "home": true,
        "urlResolution": true
      },
      "listings": [
        { "id": "popular", "name": "Populaires" },
        { "id": "latest", "name": "Derniers ajouts" }
      ],
      "urlPatterns": [
        { "pattern": "https://www.japscan.foo/manga/*", "kind": "item" },
        { "pattern": "https://www.japscan.foo/manhua/*", "kind": "item" },
        { "pattern": "https://www.japscan.foo/manhwa/*", "kind": "item" },
        { "pattern": "https://www.japscan.foo/bd/*", "kind": "item" },
        { "pattern": "https://www.japscan.foo/comic/*", "kind": "item" }
      ]
    }
  ]
